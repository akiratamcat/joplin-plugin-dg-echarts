#: src/actions.ts:116
msgid "Saved: {path}"
msgstr "Gespeichert: {path}"

#: src/actions.ts:119
msgid "Could not save: {error}"
msgstr "Konnte nicht gespeichert werden: {error}"

#: src/actions.ts:71
msgid "Copied the SVG."
msgstr "SVG kopiert."

#: src/actions.ts:71
msgid "Copied the chart source."
msgstr "Diagrammquelltext kopiert."

#: src/actions.ts:74
#: src/actions.ts:87
msgid "Could not copy: {error}"
msgstr "Konnte nicht kopiert werden: {error}"

#: src/actions.ts:84
msgid "Copied the image (PNG)."
msgstr "Bild (PNG) kopiert."

#: src/contentScript/input.ts:37
msgid "The chart is too large ({length} characters; the limit is {limit})."
msgstr "Das Diagramm ist zu groß ({length} Zeichen; die Grenze liegt bei {limit})."

#: src/contentScript/input.ts:39
msgid "The block is empty."
msgstr "Der Block ist leer."

#: src/contentScript/input.ts:62
msgid "The chart must be an object ({ ... }) with ECharts options."
msgstr "Das Diagramm muss ein Objekt ({ ... }) mit ECharts-Optionen sein."

#: src/contentScript/inputGuard.ts:47
msgid "The chart is nested too deeply (more than {depth} levels)."
msgstr "Das Diagramm ist zu tief verschachtelt (mehr als {depth} Ebenen)."

#: src/contentScript/inputGuard.ts:63
msgid "Maps (geo, series type \"map\") are not supported."
msgstr "Karten (geo, Serientyp \"map\") werden nicht unterstützt."

#: src/contentScript/markdownItPlugin.ts:102
msgid "The chart cannot be drawn here (no window to sanitise the output)."
msgstr "Das Diagramm kann hier nicht gezeichnet werden (kein window zum Bereinigen der Ausgabe)."

#: src/contentScript/markdownItPlugin.ts:106
msgid "The ECharts engine could not be loaded: {message}"
msgstr "Die ECharts-Engine konnte nicht geladen werden: {message}"

#: src/contentScript/markdownItPlugin.ts:111
msgid "ECharts could not draw the chart: {message}"
msgstr "ECharts konnte das Diagramm nicht zeichnen: {message}"

#: src/contentScript/markdownItPlugin.ts:182
msgid "The chart could not be drawn: {message}"
msgstr "Das Diagramm konnte nicht gezeichnet werden: {message}"

#: src/contentScript/markdownItPlugin.ts:62
msgid "Line {line}"
msgstr "Zeile {line}"

#: src/contentScript/markdownItPlugin.ts:71
#. Name of a chart for screen readers. "ECharts" is not translated.
msgid "ECharts chart"
msgstr "ECharts-Diagramm"

#: src/contentScript/markdownItPlugin.ts:76
#. Name of a chart for screen readers; {title} is the title of the chart.
msgid "ECharts chart: {title}"
msgstr "ECharts-Diagramm: {title}"

#: src/contentScript/markdownItPlugin.ts:86
msgid "JSON syntax error: {message}"
msgstr "JSON-Syntaxfehler: {message}"

#: src/contentScript/markdownItPlugin.ts:87
msgid "YAML syntax error: {message}"
msgstr "YAML-Syntaxfehler: {message}"

#: src/contentScript/markdownItPlugin.ts:96
msgid "Images are not shown (the plugin does not load images)."
msgstr "Bilder werden nicht angezeigt (das Plugin lädt keine Bilder)."

#: src/contentScript/optionCheck.ts:55
msgid "series[{index}] is not an object."
msgstr "series[{index}] ist kein Objekt."

#: src/contentScript/optionCheck.ts:61
msgid "series[{index}]: unknown chart type: {type}"
msgstr "series[{index}]: unbekannter Diagrammtyp: {type}"

#: src/contentScript/optionCheck.ts:66
msgid "series[{index}].data must be an array."
msgstr "series[{index}].data muss ein Array sein."

#: src/contentScript/optionCheck.ts:73
#. xAxis and yAxis are ECharts option names. Do not translate them.
msgid "Charts such as bar, line and scatter charts need both xAxis and yAxis."
msgstr "Diagramme wie Balken-, Linien- und Streudiagramme benötigen sowohl xAxis als auch yAxis."

#: src/contentScript/optionCheck.ts:79
msgid "There is nothing to draw (no series of a known chart type)."
msgstr "Es gibt nichts zu zeichnen (keine Serie eines bekannten Diagrammtyps)."

#: src/contentScript/toolbar.ts:50
msgid "Chart tools"
msgstr "Diagrammwerkzeuge"

#: src/contentScript/toolbar.ts:52
msgid "Copy SVG"
msgstr "SVG kopieren"

#: src/contentScript/toolbar.ts:53
msgid "Copy PNG"
msgstr "PNG kopieren"

#: src/contentScript/toolbar.ts:54
msgid "Save SVG"
msgstr "SVG speichern"

#: src/contentScript/toolbar.ts:55
msgid "Save PNG"
msgstr "PNG speichern"

#: src/contentScript/toolbar.ts:56
msgid "Copy the chart source"
msgstr "Diagrammquelltext kopieren"

#: src/index.ts:64
msgid "Choose a folder to save the chart in"
msgstr "Ordner zum Speichern des Diagramms wählen"

#: src/settings.ts:101
msgid "Colour ECharts blocks in the Markdown editor"
msgstr "ECharts-Blöcke im Markdown-Editor einfärben"

#: src/settings.ts:102
msgid "Keys, strings, numbers and comments of JSON and YAML get colours."
msgstr "Schlüssel, Zeichenketten, Zahlen und Kommentare von JSON und YAML werden eingefärbt."

#: src/settings.ts:110
msgid "Extra language names"
msgstr "Zusätzliche Sprachnamen"

#: src/settings.ts:112
#. "chart, json" and "echarts" are language names of code blocks. Keep them as they are.
msgid "Comma-separated, for example \"chart, json\". \"echarts\" always works."
msgstr "Kommagetrennt, zum Beispiel \"chart, json\". \"echarts\" funktioniert immer."

#: src/settings.ts:122
msgid "Largest chart (characters)"
msgstr "Größtes Diagramm (Zeichen)"

#: src/settings.ts:123
msgid "Larger blocks are not drawn. While a chart is drawn, the note waits."
msgstr "Größere Blöcke werden nicht gezeichnet. Während ein Diagramm gezeichnet wird, wartet die Notiz."

#: src/settings.ts:133
msgid "Number of charts kept in the cache"
msgstr "Anzahl der im Cache gehaltenen Diagramme"

#: src/settings.ts:146
msgid "Bundled third-party software"
msgstr "Mitgelieferte Software von Drittanbietern"

#: src/settings.ts:147
msgid "Open the list to see the name, version, license and website of each component. Choosing an item changes nothing. The full license texts are in THIRD_PARTY_NOTICES.md in the plugin package."
msgstr "Öffnen Sie die Liste, um Name, Version, Lizenz und Website jeder Komponente zu sehen. Die Auswahl eines Eintrags ändert nichts. Die vollständigen Lizenztexte stehen in THIRD_PARTY_NOTICES.md im Plugin-Paket."

#: src/settings.ts:17
#. Description at the top of the settings section. Keep ```echarts as it is.
msgid "A plugin that renders Apache ECharts charts. The Apache ECharts rendering engine is built in, and the plugin makes no network connections to the outside. Write the data in ```echarts code blocks."
msgstr "Ein Plugin, das Apache-ECharts-Diagramme zeichnet. Die Apache-ECharts-Rendering-Engine ist eingebaut, und das Plugin stellt keine Netzwerkverbindungen nach außen her. Die Daten werden in ```echarts-Codeblöcke geschrieben."

#: src/settings.ts:30
msgid "Auto (follow Joplin)"
msgstr "Automatisch (wie Joplin)"

#: src/settings.ts:32
#. A chart theme with light colours.
msgid "Light"
msgstr "Hell"

#: src/settings.ts:34
#. A chart theme with dark colours.
msgid "Dark"
msgstr "Dunkel"

#: src/settings.ts:36
msgid "Chart theme"
msgstr "Diagrammdesign"

#: src/settings.ts:43
msgid "Transparent chart background"
msgstr "Transparenter Diagrammhintergrund"

#: src/settings.ts:44
msgid "When a chart uses another theme than the page (for example theme=dark on a light page), its background is always painted."
msgstr "Wenn ein Diagramm ein anderes Design als die Seite verwendet (zum Beispiel theme=dark auf einer hellen Seite), wird sein Hintergrund immer gemalt."

#: src/settings.ts:54
msgid "Chart height (px)"
msgstr "Diagrammhöhe (px)"

#: src/settings.ts:56
#. Keep height= and ```echarts height=300 as they are.
msgid "A block can set its own height with height=, for example ```echarts height=300."
msgstr "Ein Block kann mit height= seine eigene Höhe festlegen, zum Beispiel ```echarts height=300."

#: src/settings.ts:66
msgid "Chart width (px)"
msgstr "Diagrammbreite (px)"

#: src/settings.ts:68
#. Keep width= as it is.
msgid "Charts are drawn at this width and shrink in a narrower pane; they are never stretched. A block can set its own width with width=."
msgstr "Diagramme werden in dieser Breite gezeichnet und in einem schmaleren Bereich verkleinert; sie werden nie gestreckt. Ein Block kann mit width= seine eigene Breite festlegen."

#: src/settings.ts:75
msgid "Match the font size of the note"
msgstr "Schriftgröße der Notiz übernehmen"

#: src/settings.ts:76
msgid "Chart texts use the font size of the note text (15px in the desktop app) instead of 12px. Titles and other texts keep their proportions."
msgstr "Diagrammtexte verwenden die Schriftgröße des Notiztexts (15px in der Desktop-App) statt 12px. Titel und andere Texte behalten ihre Proportionen."

#: src/settings.ts:85
msgid "Smallest font size (px)"
msgstr "Kleinste Schriftgröße (px)"

#: src/settings.ts:86
msgid "0 turns it off. Smaller texts, including sizes written in a chart, are enlarged before the chart is laid out. A chart that shrinks in a narrow pane shows smaller texts."
msgstr "0 schaltet es aus. Kleinere Texte, auch im Diagramm angegebene Größen, werden vor dem Layout vergrößert. Ein Diagramm, das in einem schmalen Bereich verkleinert wird, zeigt kleinere Texte."

#: src/settings.ts:93
msgid "Show the chart toolbar"
msgstr "Diagramm-Werkzeugleiste anzeigen"

#: src/settings.ts:94
msgid "Buttons to copy and save the chart (SVG, PNG) and to copy its source, shown when the mouse is over a chart."
msgstr "Schaltflächen zum Kopieren und Speichern des Diagramms (SVG, PNG) und zum Kopieren des Quelltexts, angezeigt, wenn sich die Maus über einem Diagramm befindet."
